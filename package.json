{
  "name": "lexi-arcade",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply lexi-db --local",
    "db:migrate:staging": "wrangler d1 migrations apply lexi-db --env staging --remote",
    "db:migrate:prod": "wrangler d1 migrations apply lexi-db --remote",
    "content:build": "tsx scripts/content/build.ts",
    "content:validate": "tsx scripts/content/validate.ts",
    "content:seed": "tsx scripts/content/seed.ts",
    "content:tts": "tsx scripts/content/tts.ts",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "mitt": "^3.0.1",
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
