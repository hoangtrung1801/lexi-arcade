{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lexi-arcade",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lexi-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "lexi-audio" }],
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_SESSIONS", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": { "APP_URL": "http://localhost:5173" },
  "env": {
    "staging": {
      "name": "lexi-arcade-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lexi-db-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],
      "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "lexi-audio-staging" }],
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_SESSIONS", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } }
      ],
      "vars": { "APP_URL": "https://lexi-arcade-staging.example.workers.dev" }
    }
  }
}
